# Amazon ML Challenge 2026 - Environment Configuration Template
# Copy this file to .env and configure values according to your environment.
# Note: Never commit .env with real credentials or bucket names to git.

# Environment mode: local or sage
ENVIRONMENT=local
LOG_LEVEL=INFO

# Remote Compute & Persistent Storage (to be populated in Sage/production)
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=
S3_DATA_PREFIX=raw/dataset
S3_ARTIFACTS_PREFIX=artifacts/validation

# Local filesystem directory overrides (optional)
PROJECT_DATA_DIR=data
PROJECT_ARTIFACTS_DIR=artifacts
PROJECT_CONFIGS_DIR=configs
PROJECT_EXPERIMENTS_DIR=experiments
